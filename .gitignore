# upstream zhang2025 reference decoder outputs (~7M, not used by harbor task).
# Wildcarded so task variants (e.g. zhang2025_minimal) are covered too.
harbor-tasks/*/environment/code/code_zhang2025/data/example_decoder_outputs/

# superseded MAP notebooks (~130M): not reference material for the task, and
# they ship into the agent's container via the Dockerfile's `COPY . .`
harbor-tasks/*/environment/code/Archive/

harbor-tasks/allen2p/environment/tutorials/visual_behavior_load_ophys_data.ipynb
# Job results live in their own repo at harbor-jobs/ (nested, not a submodule).
# Results churn on every rerun and are irrelevant to anyone cloning this repo to
# run the benchmark; the pickles inside are symlinks to /nearline.
/harbor-jobs/

# copies of trajectory data which we did not analyze
evaluation/eval/trajectory