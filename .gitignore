# upstream zhang2025 reference decoder outputs (~7M, not used by harbor task).
# Wildcarded so task variants (e.g. zhang2025_minimal) are covered too.
harbor-tasks/*/environment/code/code_zhang2025/data/example_decoder_outputs/

# superseded MAP notebooks (~130M): not reference material for the task, and
# they ship into the agent's container via the Dockerfile's `COPY . .`
harbor-tasks/*/environment/code/Archive/

# Trial results collected off the cluster by harbor-scripts/collect_cluster_results.py.
# Tens of GB of agent output (a single trial has reached 20G), living in the working
# tree only because it shares a filesystem with harbor-cluster-jobs, which makes the
# collection an instant rename instead of a copy to /nearline.
harbor-jobs-new/